{
  "compilerOptions": {
    // File Layout
    "rootDir": ".",
    "outDir": "dist",

    // Node + ESM setup
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2020",

    // Node types (IMPORTANT)
    "types": ["node"],

    // Output
    "sourceMap": true,

    // Strictness
    "strict": true,

    // Compatibility
    "esModuleInterop": true,
    "resolveJsonModule": true,

    // Clean build
    "skipLibCheck": true
  }
}